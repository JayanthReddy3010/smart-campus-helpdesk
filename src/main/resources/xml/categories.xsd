<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://smartcampus.example/xml/categories"
           xmlns="https://smartcampus.example/xml/categories"
           elementFormDefault="qualified">
    <xs:element name="categories">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="category" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="name" type="CategoryName"/>
                            <xs:element name="description" type="Description"/>
                            <xs:element name="active" type="xs:boolean"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="version" use="required" fixed="1"/>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="CategoryName">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="100"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Description">
        <xs:restriction base="xs:string">
            <xs:maxLength value="500"/>
        </xs:restriction>
    </xs:simpleType>
</xs:schema>
